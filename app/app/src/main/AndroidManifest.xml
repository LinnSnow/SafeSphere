<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="SafeSphere"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SafeSphere">

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.WelcomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.screens.HomeActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.TransparencyActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.FamilyActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.RoleActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.TeenCodeActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.PairActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.PermissionStepActivity"
            android:exported="false" />

        <activity
            android:name=".ui.screens.SetPinActivity"
            android:exported="false" />

        <!-- Person 2: reads notification previews on-device so the ML model can warn the teen -->
        <service
            android:name=".ml.NotificationMonitorService"
            android:exported="true"
            android:label="SafeSphere Text Protection"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>